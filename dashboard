<!DOCTYPE html>
<html lang="es">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>Dashboard General - Camino hacia Jesús 2026</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f4f6f9; font-family: 'Segoe UI', Roboto, sans-serif; }
    .header-dashboard { background: linear-gradient(135deg, #1b365d 0%, #2a4b7c 100%); color: white; padding: 25px 20px; border-radius: 0 0 20px 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    .card-metric { border: none; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.2s; }
    .card-metric:hover { transform: translateY(-5px); }
    .icon-box { width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 15px; }
  </style>
</head>
<body>

  <!-- Cabecera -->
  <header class="header-dashboard mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <div>
        <span class="badge bg-warning text-dark mb-1">PANEL DE CONTROL GLOBAL</span>
        <h3 class="fw-bold m-0">📊 Dashboard Administrativo</h3>
        <small class="opacity-75">Camino hacia Jesús 2026</small>
      </div>
      <a href="<?= ScriptApp.getService().getUrl() ?>" class="btn btn-outline-light btn-sm fw-bold rounded-pill px-3 shadow-sm">⬅️ Volver al Inicio</a>
    </div>
  </header>

  <main class="container mb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h5 class="fw-bold text-dark m-0">Resumen en Tiempo Real</h5>
      <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" onclick="cargarDashboard()">🔄 Actualizar Datos</button>
    </div>

    <!-- Tarjetas de Métricas -->
    <div class="row g-4">
      
      <!-- Catequizandos -->
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card card-metric p-3 text-center h-100 border-bottom border-4 border-warning">
          <div class="icon-box bg-warning bg-opacity-10 text-warning mx-auto">👧🧒</div>
          <h3 class="fw-bold text-dark m-0" id="dashCatequizandos">...</h3>
          <small class="text-muted fw-bold">NIÑOS INSCRITOS</small>
        </div>
      </div>

      <!-- Sesiones -->
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card card-metric p-3 text-center h-100 border-bottom border-4 border-primary">
          <div class="icon-box bg-primary bg-opacity-10 text-primary mx-auto">🗓️</div>
          <h3 class="fw-bold text-dark m-0" id="dashSesiones">...</h3>
          <small class="text-muted fw-bold">SESIONES PROG.</small>
        </div>
      </div>

      <!-- Clases -->
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card card-metric p-3 text-center h-100 border-bottom border-4 border-success">
          <div class="icon-box bg-success bg-opacity-10 text-success mx-auto">✅</div>
          <h3 class="fw-bold text-dark m-0" id="dashClases">...</h3>
          <small class="text-muted fw-bold">CLASES DICTADAS</small>
        </div>
      </div>

      <!-- Tareas -->
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card card-metric p-3 text-center h-100 border-bottom border-4 border-info">
          <div class="icon-box bg-info bg-opacity-10 text-info mx-auto">📝</div>
          <h3 class="fw-bold text-dark m-0" id="dashTareas">...</h3>
          <small class="text-muted fw-bold">TAREAS ENTREGADAS</small>
        </div>
      </div>

      <!-- Avisos -->
      <div class="col-12 col-md-4 col-lg-4">
        <div class="card card-metric p-3 text-center h-100 border-bottom border-4 border-danger">
          <div class="icon-box bg-danger bg-opacity-10 text-danger mx-auto">🔔</div>
          <h3 class="fw-bold text-dark m-0" id="dashAvisos">...</h3>
          <small class="text-muted fw-bold">AVISOS Y COMUNICADOS</small>
        </div>
      </div>

    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      cargarDashboard();
    });

    function cargarDashboard() {
      // Indicador de carga
      const ids = ['dashCatequizandos', 'dashSesiones', 'dashClases', 'dashTareas', 'dashAvisos'];
      ids.forEach(id => document.getElementById(id).innerText = '...');

      // Llamada al backend
      google.script.run.withSuccessHandler(function(data) {
        document.getElementById('dashCatequizandos').innerText = data.totalCatequizandos;
        document.getElementById('dashSesiones').innerText = data.totalSesiones;
        document.getElementById('dashClases').innerText = data.totalClases;
        document.getElementById('dashTareas').innerText = data.totalTareas;
        document.getElementById('dashAvisos').innerText = data.totalAvisos;
      }).getDashboard();
    }
  </script>
</body>
</html>
